# 复制这个文件为 .env 后修改
# cp .env.example .env

PROJECT_NAME=Campus RAG Agent
DEBUG=true

# 本地模型（默认，免费）
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# 如果要用在线 API，把 LLM_PROVIDER 改成 openai 并填密钥
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

TEMPERATURE=0.2
MAX_LOOPS=3